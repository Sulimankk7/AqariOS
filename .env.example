# API security. Both secrets must be unique and at least 32 bytes long.
JWT_SECRET=H/TDaOUG1ojDgehu97yuffs1ZamR0W04CZXPiUDR4CA=
JWT_ISSUER=PropertyOS
JWT_AUDIENCE=PropertyOS-Clients
RefreshSession__NormalLifetimeDays=7
RefreshSession__RememberedLifetimeDays=30
FILE_STORAGE_URL_SIGNING_SECRET=G7XqPZ8Sm1gZttuDlvwj8jIyvniFdv8UVXoFeLbpvtg=

# Runtime and published host ports.
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5235
