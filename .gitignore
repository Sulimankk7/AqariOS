## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Release]/
[Releases]/
x64/
x86/
[AR]M/
[AR]M64/
bld/
[Bin]/
[Obj]/
[Log]/
[Logs]/
bin/
obj/

# Visual Studio 2015/2017 cache directory
.vs/
# Generated user files
*.html
*.htm
*.xhtml

# Console Classifier cache
.cache/

# Output of dotnet build
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolder
App_Data/Jobs/

# PowerShell
*.log

# SASS/SCSS Web Compiler
.sass-cache/
*.css
*.min.css
*.css.map
*.min.css.map

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local env files / Secrets
.env
.env.*
appsettings.local.json
appsettings.*.local.json
src/PropertyOS.Api/appsettings.Local.json
secrets.json

# Rider
.idea/



# Test artifacts
TestResults/
*.trx
*.xml
*.html
