{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Database.Transaction": "Information",
        "PropertyOS.Infrastructure.Persistence.Behaviors": "Information",
        "PropertyOS.Infrastructure.Persistence.Interceptors": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Database.Transaction": "Information"
    }
  },
  "Cors": {
    "AllowLoopbackOrigins": true,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://192.168.0.106:5173",
      "http://192.168.0.105:5173"
    ]
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=AqariOS;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Secret": "placeholder-long-secret-key-32-chars-minimum"
  },
  "Sentry": {
    "Environment": "Development"
  }
}

